# ตัวอย่างค่าตั้งค่า · คัดลอกไฟล์นี้เป็น backend/.env แล้วใส่ค่าของเครื่องนั้น
# .env ไม่ขึ้น git: เครื่อง dev กับเครื่อง server มี .env ของตัวเองคนละไฟล์ sync โค้ดแล้วค่าไม่ทับกัน
# ห้ามใส่รหัสผ่านหรือกุญแจจริงในไฟล์นี้ (ไฟล์นี้ขึ้น GitHub)

# พอร์ตของเซิร์ฟเวอร์ TruckQueue
PORT=3000

# ฐานข้อมูล MariaDB
#   เครื่อง server: ฐานข้อมูลอยู่เครื่องเดียวกัน ใช้ 127.0.0.1 / 3306
#   เครื่อง dev:    ใส่ที่อยู่ที่ต่อถึงฐานข้อมูลของ server ได้ (เช่นชื่อ DDNS และพอร์ตที่เปิดไว้)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=truckqueue_db

# ที่อยู่ https สำหรับคนขับ (ผ่าน Cloudflare Tunnel) · เครื่อง dev เว้นว่างได้
PUBLIC_URL=
# ชื่อ tunnel ของ cloudflared · ใส่เฉพาะเครื่อง server แล้ว start-all.bat จะเปิด tunnel ให้เอง
TUNNEL_NAME=

# Web Push: สร้างด้วย npm run push:keys (เติมให้ใน .env เอง)
#   ถ้า dev กับ server ใช้ฐานข้อมูลเดียวกัน ต้องใช้กุญแจชุดเดียวกันทั้งสองเครื่อง
#   (คัดลอกค่าจาก .env ของ server มาใส่) ไม่งั้นแจ้งเตือนที่ส่งจากอีกเครื่องจะส่งไม่ผ่าน
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# เว้นว่างได้ ระบบใช้ PUBLIC_URL แทน
VAPID_SUBJECT=
